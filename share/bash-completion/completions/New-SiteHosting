_new_sitehosting() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD - 1]}"

    opts="-h --help -n --name -d --domain -r --repo -b --default-branch --skip-azure --skip-github --dry-run"

    case "${prev}" in
        -n | --name | -d | --domain)
            # A free value: nothing to offer
            return 0
            ;;
        -r | --repo)
            # The repositories gh can see under the login's own account and its organizations
            COMPREPLY=($(compgen -W "$(gh repo list --limit 100 --json nameWithOwner --jq '.[].nameWithOwner' 2>/dev/null)" -- "${cur}"))
            return 0
            ;;
        -b | --default-branch)
            COMPREPLY=($(compgen -W "develop main" -- "${cur}"))
            return 0
            ;;
    esac

    if [[ ${cur} == -* ]]; then
        COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
        return 0
    fi

    return 0
}

complete -F _new_sitehosting New-SiteHosting
