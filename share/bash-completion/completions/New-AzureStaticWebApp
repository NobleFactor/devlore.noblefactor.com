_new_azurestaticwebapp() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD - 1]}"

    opts="-h --help -n --name -d --domain"

    case "${prev}" in
        -n | --name | -d | --domain)
            # A free value: nothing to offer
            return 0
            ;;
    esac

    if [[ ${cur} == -* ]]; then
        COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
        return 0
    fi

    return 0
}

complete -F _new_azurestaticwebapp New-AzureStaticWebApp
