---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = "", size = 120 } = Astro.props;
---

<!-- Registry: Community knowledge repository - depicted as interconnected nodes/network -->
<svg
  viewBox="0 0 120 120"
  width={size}
  height={size}
  class={className}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Central hub -->
  <circle cx="60" cy="60" r="12" stroke="currentColor" stroke-width="2" class="text-lore-accent" />
  <circle cx="60" cy="60" r="6" fill="currentColor" class="text-lore-accent opacity-40" />

  <!-- Outer nodes -->
  <circle cx="30" cy="30" r="8" stroke="currentColor" stroke-width="1.5" class="text-gray-400" />
  <circle cx="90" cy="30" r="8" stroke="currentColor" stroke-width="1.5" class="text-gray-400" />
  <circle cx="30" cy="90" r="8" stroke="currentColor" stroke-width="1.5" class="text-gray-400" />
  <circle cx="90" cy="90" r="8" stroke="currentColor" stroke-width="1.5" class="text-gray-400" />
  <circle cx="60" cy="15" r="6" stroke="currentColor" stroke-width="1.5" class="text-gray-400" />
  <circle cx="60" cy="105" r="6" stroke="currentColor" stroke-width="1.5" class="text-gray-400" />
  <circle cx="15" cy="60" r="6" stroke="currentColor" stroke-width="1.5" class="text-gray-400" />
  <circle cx="105" cy="60" r="6" stroke="currentColor" stroke-width="1.5" class="text-gray-400" />

  <!-- Connection lines -->
  <line x1="48" y1="52" x2="36" y2="38" stroke="currentColor" stroke-width="1" class="text-gray-500" />
  <line x1="72" y1="52" x2="84" y2="38" stroke="currentColor" stroke-width="1" class="text-gray-500" />
  <line x1="48" y1="68" x2="36" y2="82" stroke="currentColor" stroke-width="1" class="text-gray-500" />
  <line x1="72" y1="68" x2="84" y2="82" stroke="currentColor" stroke-width="1" class="text-gray-500" />
  <line x1="60" y1="48" x2="60" y2="21" stroke="currentColor" stroke-width="1" class="text-gray-500" />
  <line x1="60" y1="72" x2="60" y2="99" stroke="currentColor" stroke-width="1" class="text-gray-500" />
  <line x1="48" y1="60" x2="21" y2="60" stroke="currentColor" stroke-width="1" class="text-gray-500" />
  <line x1="72" y1="60" x2="99" y2="60" stroke="currentColor" stroke-width="1" class="text-gray-500" />

  <!-- Small dots on nodes representing PMMs -->
  <circle cx="30" cy="30" r="2" fill="currentColor" class="text-lore-accent opacity-60" />
  <circle cx="90" cy="30" r="2" fill="currentColor" class="text-lore-accent opacity-60" />
  <circle cx="30" cy="90" r="2" fill="currentColor" class="text-lore-accent opacity-60" />
  <circle cx="90" cy="90" r="2" fill="currentColor" class="text-lore-accent opacity-60" />
</svg>
