---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = "", size = 120 } = Astro.props;
---

<!-- Writ: Dotfiles manager - depicted as config document with symlink arrows -->
<svg
  viewBox="0 0 120 120"
  width={size}
  height={size}
  class={className}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Main document -->
  <rect
    x="35" y="20" width="50" height="65" rx="3"
    stroke="currentColor" stroke-width="2" class="text-gray-400"
    fill="currentColor" fill-opacity="0.05"
  />

  <!-- Document fold corner -->
  <path
    d="M70 20 L70 32 L85 32"
    stroke="currentColor" stroke-width="1.5" class="text-gray-500"
  />
  <path
    d="M70 20 L85 32"
    stroke="currentColor" stroke-width="1.5" class="text-gray-500"
  />

  <!-- Config lines (representing .zshrc, .gitconfig, etc.) -->
  <line x1="43" y1="40" x2="65" y2="40" stroke="currentColor" stroke-width="2" class="text-lore-accent" />
  <line x1="43" y1="50" x2="77" y2="50" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
  <line x1="43" y1="58" x2="70" y2="58" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
  <line x1="43" y1="66" x2="60" y2="66" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
  <line x1="43" y1="74" x2="72" y2="74" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />

  <!-- Symlink arrows going out -->
  <!-- Arrow to left (representing ~/.zshrc) -->
  <path
    d="M35 40 C20 40, 15 55, 15 70"
    stroke="currentColor" stroke-width="1.5" class="text-lore-accent"
    stroke-dasharray="4 2"
  />
  <circle cx="15" cy="75" r="4" stroke="currentColor" stroke-width="1.5" class="text-lore-accent" />

  <!-- Arrow to right (representing ~/.config/nvim) -->
  <path
    d="M85 50 C100 50, 105 65, 105 80"
    stroke="currentColor" stroke-width="1.5" class="text-gray-500"
    stroke-dasharray="4 2"
  />
  <circle cx="105" cy="85" r="4" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />

  <!-- Home directory indicator -->
  <text x="10" y="92" class="text-gray-500" fill="currentColor" font-size="10" font-family="monospace">~</text>
  <text x="100" y="102" class="text-gray-500" fill="currentColor" font-size="10" font-family="monospace">~</text>

  <!-- Dot file indicator at top -->
  <circle cx="45" cy="40" r="2" fill="currentColor" class="text-lore-accent" />
</svg>
