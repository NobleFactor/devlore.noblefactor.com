---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- Hero Diagram: Shows Registry → Lore → Writ flow with unified output -->
<svg
  viewBox="0 0 800 200"
  class={`w-full max-w-4xl mx-auto ${className}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Registry Section -->
  <g transform="translate(50, 50)">
    <!-- Network nodes representing community knowledge -->
    <circle cx="60" cy="50" r="20" stroke="currentColor" stroke-width="2" class="text-lore-accent" fill="currentColor" fill-opacity="0.1" />
    <circle cx="20" cy="30" r="10" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
    <circle cx="100" cy="30" r="10" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
    <circle cx="20" cy="70" r="10" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
    <circle cx="100" cy="70" r="10" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
    <line x1="40" y1="50" x2="28" y2="38" stroke="currentColor" stroke-width="1" class="text-gray-600" />
    <line x1="80" y1="50" x2="92" y2="38" stroke="currentColor" stroke-width="1" class="text-gray-600" />
    <line x1="40" y1="50" x2="28" y2="62" stroke="currentColor" stroke-width="1" class="text-gray-600" />
    <line x1="80" y1="50" x2="92" y2="62" stroke="currentColor" stroke-width="1" class="text-gray-600" />
    <!-- Small dots -->
    <circle cx="60" cy="50" r="6" fill="currentColor" class="text-lore-accent opacity-50" />
    <!-- Label -->
    <text x="60" y="110" text-anchor="middle" class="text-gray-300" fill="currentColor" font-size="14" font-weight="600">Registry</text>
    <text x="60" y="125" text-anchor="middle" class="text-gray-500" fill="currentColor" font-size="10">Community Knowledge</text>
  </g>

  <!-- Arrow 1: Registry → Lore -->
  <g transform="translate(180, 85)">
    <path d="M0 15 L60 15" stroke="currentColor" stroke-width="2" class="text-gray-600" stroke-dasharray="6 4" />
    <path d="M55 10 L65 15 L55 20" stroke="currentColor" stroke-width="2" class="text-gray-600" fill="none" />
  </g>

  <!-- Lore Section -->
  <g transform="translate(280, 50)">
    <!-- Package box -->
    <path d="M60 10 L100 30 L60 50 L20 30 Z" stroke="currentColor" stroke-width="2" class="text-gray-400" fill="currentColor" fill-opacity="0.05" />
    <path d="M20 30 L60 50 L60 80 L20 60 Z" stroke="currentColor" stroke-width="2" class="text-gray-400" fill="currentColor" fill-opacity="0.1" />
    <path d="M100 30 L60 50 L60 80 L100 60 Z" stroke="currentColor" stroke-width="2" class="text-gray-400" fill="currentColor" fill-opacity="0.15" />
    <!-- Checkmark badge -->
    <circle cx="95" cy="18" r="14" stroke="currentColor" stroke-width="1.5" class="text-lore-accent" fill="currentColor" fill-opacity="0.15" />
    <path d="M88 18 L93 23 L102 14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-lore-accent" />
    <!-- Label -->
    <text x="60" y="110" text-anchor="middle" class="text-gray-300" fill="currentColor" font-size="14" font-weight="600">Lore</text>
    <text x="60" y="125" text-anchor="middle" class="text-gray-500" fill="currentColor" font-size="10">The Wisdom</text>
  </g>

  <!-- Arrow 2: Lore → Writ -->
  <g transform="translate(410, 85)">
    <path d="M0 15 L60 15" stroke="currentColor" stroke-width="2" class="text-gray-600" stroke-dasharray="6 4" />
    <path d="M55 10 L65 15 L55 20" stroke="currentColor" stroke-width="2" class="text-gray-600" fill="none" />
  </g>

  <!-- Writ Section -->
  <g transform="translate(510, 50)">
    <!-- Document -->
    <rect x="30" y="5" width="60" height="70" rx="3" stroke="currentColor" stroke-width="2" class="text-gray-400" fill="currentColor" fill-opacity="0.05" />
    <path d="M75 5 L75 18 L90 18" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
    <!-- Config lines -->
    <line x1="40" y1="30" x2="65" y2="30" stroke="currentColor" stroke-width="2" class="text-lore-accent" />
    <line x1="40" y1="42" x2="80" y2="42" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
    <line x1="40" y1="52" x2="70" y2="52" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
    <line x1="40" y1="62" x2="75" y2="62" stroke="currentColor" stroke-width="1.5" class="text-gray-500" />
    <!-- Symlink indicator -->
    <path d="M30 40 C10 40, 5 60, 5 75" stroke="currentColor" stroke-width="1.5" class="text-lore-accent" stroke-dasharray="4 2" />
    <circle cx="5" cy="80" r="5" stroke="currentColor" stroke-width="1.5" class="text-lore-accent" />
    <!-- Label -->
    <text x="60" y="110" text-anchor="middle" class="text-gray-300" fill="currentColor" font-size="14" font-weight="600">Writ</text>
    <text x="60" y="125" text-anchor="middle" class="text-gray-500" fill="currentColor" font-size="10">The Written Form</text>
  </g>

  <!-- Arrow 3: Writ → Result -->
  <g transform="translate(630, 85)">
    <path d="M0 15 L50 15" stroke="currentColor" stroke-width="2" class="text-lore-accent" />
    <path d="M45 10 L55 15 L45 20" stroke="currentColor" stroke-width="2" class="text-lore-accent" fill="none" />
  </g>

  <!-- Result Section: Ready Environment -->
  <g transform="translate(700, 50)">
    <!-- Terminal/Machine representation -->
    <rect x="10" y="10" width="70" height="55" rx="5" stroke="currentColor" stroke-width="2" class="text-lore-accent" fill="currentColor" fill-opacity="0.1" />
    <!-- Terminal header -->
    <line x1="10" y1="22" x2="80" y2="22" stroke="currentColor" stroke-width="1" class="text-lore-accent opacity-50" />
    <!-- Prompt and cursor -->
    <text x="18" y="38" class="text-lore-accent" fill="currentColor" font-size="11" font-family="monospace">$ _</text>
    <!-- Checkmarks -->
    <text x="18" y="52" class="text-lore-accent" fill="currentColor" font-size="10" font-family="monospace">Ready</text>
    <!-- Label -->
    <text x="45" y="110" text-anchor="middle" class="text-lore-accent" fill="currentColor" font-size="14" font-weight="600">You</text>
    <text x="45" y="125" text-anchor="middle" class="text-gray-500" fill="currentColor" font-size="10">Productive</text>
  </g>
</svg>
