---
import BaseLayout from "./BaseLayout.astro";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
}

const { title, description, currentSlug } = Astro.props;

const allGuides = await getCollection("guides");

// Group by tool, sorted by order
const gettingStarted = allGuides
  .filter((g) => g.data.tool === "devlore")
  .sort((a, b) => a.data.order - b.data.order);
const writGuides = allGuides
  .filter((g) => g.data.tool === "writ")
  .sort((a, b) => a.data.order - b.data.order);
const loreGuides = allGuides
  .filter((g) => g.data.tool === "lore")
  .sort((a, b) => a.data.order - b.data.order);

// Build breadcrumbs
function buildBreadcrumbs(slug: string | undefined) {
  if (!slug) return [];
  const parts = slug.split("/");
  const crumbs = [];
  for (let i = 0; i < parts.length; i++) {
    const path = parts.slice(0, i + 1).join("/");
    crumbs.push({
      label: parts[i].replace(/-/g, " "),
      href: `/guides/${path}/`,
      active: i === parts.length - 1,
    });
  }
  return crumbs;
}

const breadcrumbs = buildBreadcrumbs(currentSlug);

function categoryBadge(cat: string) {
  switch (cat) {
    case "tutorial": return "bg-blue-900/50 text-blue-300";
    case "concept": return "bg-purple-900/50 text-purple-300";
    case "overview": return "bg-green-900/50 text-green-300";
    default: return "bg-gray-800 text-gray-300";
  }
}
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-6 py-8 flex flex-col lg:flex-row gap-8">
    <!-- Sidebar -->
    <aside class="lg:w-56 shrink-0">
      <nav class="sticky top-8">
        <a href="/guides/" class="block text-sm font-semibold text-lore-accent mb-4 hover:underline">
          &larr; Guides
        </a>

        {gettingStarted.length > 0 && (
          <div class="mb-5">
            <ul class="space-y-1">
              {gettingStarted.map((g) => (
                <li>
                  <a
                    href={`/guides/${g.slug}/`}
                    class={`block text-sm py-0.5 transition ${
                      currentSlug === g.slug
                        ? "text-lore-accent font-medium"
                        : "text-gray-300 hover:text-white"
                    }`}
                  >
                    {g.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {writGuides.length > 0 && (
          <div class="mb-5">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">writ</h3>
            <ul class="space-y-1">
              {writGuides.map((g) => (
                <li>
                  <a
                    href={`/guides/${g.slug}/`}
                    class={`block text-sm py-0.5 transition ${
                      currentSlug === g.slug
                        ? "text-lore-accent font-medium"
                        : "text-gray-300 hover:text-white"
                    }`}
                  >
                    {g.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {loreGuides.length > 0 && (
          <div class="mb-5">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">lore</h3>
            <ul class="space-y-1">
              {loreGuides.map((g) => (
                <li>
                  <a
                    href={`/guides/${g.slug}/`}
                    class={`block text-sm py-0.5 transition ${
                      currentSlug === g.slug
                        ? "text-lore-accent font-medium"
                        : "text-gray-300 hover:text-white"
                    }`}
                  >
                    {g.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </nav>
    </aside>

    <!-- Main content -->
    <article class="flex-1 min-w-0">
      {breadcrumbs.length > 0 && (
        <nav class="mb-6 text-sm text-gray-400">
          <ol class="flex flex-wrap gap-1 items-center">
            <li><a href="/guides/" class="hover:text-white transition">guides</a></li>
            {breadcrumbs.map((crumb) => (
              <>
                <li class="text-gray-600">/</li>
                <li>
                  {crumb.active ? (
                    <span class="text-white">{crumb.label}</span>
                  ) : (
                    <a href={crumb.href} class="hover:text-white transition">{crumb.label}</a>
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose prose-invert prose-sm max-w-none
        prose-headings:text-white
        prose-h1:text-2xl prose-h1:mb-4
        prose-h2:text-lg prose-h2:mt-8 prose-h2:mb-3 prose-h2:border-b prose-h2:border-gray-700 prose-h2:pb-2
        prose-h3:text-base prose-h3:mt-6
        prose-code:text-lore-accent prose-code:bg-gray-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-700
        prose-table:text-sm
        prose-th:text-left prose-th:text-gray-300 prose-th:border-gray-700
        prose-td:border-gray-700
        prose-a:text-lore-accent prose-a:no-underline hover:prose-a:underline
        prose-strong:text-white
        prose-p:text-gray-300
        prose-li:text-gray-300">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
