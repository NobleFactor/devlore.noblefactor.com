---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import RegistryIcon from '../components/RegistryIcon.astro';
import LoreIcon from '../components/LoreIcon.astro';
import WritIcon from '../components/WritIcon.astro';
import DocsLinks from '../components/DocsLinks.astro';
---

<BaseLayout title="DevLore - Tribal Knowledge, Automated">
  <!-- Hero Section -->
  <section class="container mx-auto px-6 py-20 text-center">
    <p class="text-lore-accent font-mono text-sm mb-4 tracking-wider">TRIBAL KNOWLEDGE, AUTOMATED</p>
    <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
      Your environment.<br />
      <span class="text-lore-accent">Reproducible everywhere.</span>
    </h1>
    <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed">
      Stop spending days setting up new machines. DevLore captures the hard-won knowledge of
      experienced developers and transforms it into one-command deployments that actually work.
      Cross-platform. Verified. Ready in minutes.
    </p>
    <div class="bg-gray-900 rounded-lg p-4 max-w-xl mx-auto text-left font-mono text-sm border border-gray-800">
      <code class="text-gray-500">$</code>
      <code class="text-lore-accent"> curl -sSL https://devlore.noblefactor.com/install | sh</code>
    </div>
  </section>

  <!-- Hero Diagram: The Flow -->
  <section class="py-12 overflow-hidden">
    <div class="container mx-auto px-6">
      <HeroDiagram class="opacity-90" />
    </div>
  </section>

  <!-- Problem Section -->
  <section class="bg-gray-900/50 py-20">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">The Problem</h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Every engineering team suffers from the same knowledge gaps.
      </p>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
          <h3 class="text-xl font-semibold mb-3 text-red-400">Onboarding Takes Days</h3>
          <p class="text-gray-400">
            "I started Monday. It's Thursday. I still can't build the app."
          </p>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
          <h3 class="text-xl font-semibold mb-3 text-red-400">Docs Are Always Stale</h3>
          <p class="text-gray-400">
            47-step wiki page. Last updated by someone who left two years ago.
          </p>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
          <h3 class="text-xl font-semibold mb-3 text-red-400">Tribal Knowledge Walks Out</h3>
          <p class="text-gray-400">
            The engineer who knows everything is leaving. Her knowledge leaves too.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The DevLore Suite: Three Products -->
  <section id="products" class="py-24">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">The DevLore Suite</h2>
      <p class="text-gray-400 text-center mb-16 max-w-2xl mx-auto">
        Three tools that work together to make developer environments reproducible.
      </p>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Registry Card -->
        <a href="/registry" class="group bg-gray-800/50 rounded-xl p-8 border border-gray-700 hover:border-lore-accent transition-all hover:bg-gray-800">
          <div class="flex justify-center mb-6">
            <RegistryIcon size={100} class="group-hover:scale-110 transition-transform" />
          </div>
          <h3 class="text-2xl font-bold mb-2 text-center">Registry</h3>
          <p class="text-lore-accent text-sm mb-4 text-center font-mono">Community Knowledge</p>
          <p class="text-gray-400 text-center">
            A crowdsourced repository of lore packages. Hard-won installation
            wisdom from developers who've been there, encoded and shared.
          </p>
          <p class="text-center mt-6 text-lore-accent group-hover:underline">
            Learn more &rarr;
          </p>
        </a>

        <!-- Lore Card -->
        <a href="/lore" class="group bg-gray-800/50 rounded-xl p-8 border border-gray-700 hover:border-lore-accent transition-all hover:bg-gray-800">
          <div class="flex justify-center mb-6">
            <LoreIcon size={100} class="group-hover:scale-110 transition-transform" />
          </div>
          <h3 class="text-2xl font-bold mb-2 text-center">Lore</h3>
          <p class="text-lore-accent text-sm mb-4 text-center font-mono">The Wisdom</p>
          <p class="text-gray-400 text-center">
            Tribal knowledge about installing software. Installs, configures,
            and <em>proves it works</em>. Four phases: prepare, install, provision, verify.
          </p>
          <p class="text-center mt-6 text-lore-accent group-hover:underline">
            Learn more &rarr;
          </p>
        </a>

        <!-- Writ Card -->
        <a href="/writ" class="group bg-gray-800/50 rounded-xl p-8 border border-gray-700 hover:border-lore-accent transition-all hover:bg-gray-800">
          <div class="flex justify-center mb-6">
            <WritIcon size={100} class="group-hover:scale-110 transition-transform" />
          </div>
          <h3 class="text-2xl font-bold mb-2 text-center">Writ</h3>
          <p class="text-lore-accent text-sm mb-4 text-center font-mono">The Written Form</p>
          <p class="text-gray-400 text-center">
            Your configuration, inscribed. Dotfiles manager with platform-aware symlinks.
            Orchestrates lore—what's writ is what runs.
          </p>
          <p class="text-center mt-6 text-lore-accent group-hover:underline">
            Learn more &rarr;
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Demo Section -->
  <section id="demo" class="bg-gray-900/50 py-20">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">See It In Action</h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Day one. Point lore at your team's wiki. Get a working manifest. Deploy with confidence.
      </p>
      <div class="bg-gray-900 rounded-lg p-6 max-w-3xl mx-auto font-mono text-sm border border-gray-800">
        <div class="mb-4">
          <span class="text-gray-500"># New hire, Day 1: point lore at the team wiki</span>
        </div>
        <div class="mb-4">
          <span class="text-gray-400">$</span>
          <span class="text-white"> lore onboard --from https://wiki.acme.com/backend-setup</span>
        </div>
        <div class="mt-6 space-y-2">
          <div class="text-gray-400">Found 15 items:</div>
          <div class="ml-4"><span class="text-lore-accent">HIGH confidence:</span> <span class="text-gray-400">6 (docker, kubectl --with eks-auth, go, node, helm, bazel)</span></div>
          <div class="ml-4"><span class="text-yellow-400">MEDIUM confidence:</span> <span class="text-gray-400">2 (aws-cli, terraform)</span></div>
          <div class="ml-4"><span class="text-red-400">LOW confidence:</span> <span class="text-gray-400">5 (acme-cli, acme-secrets, internal-proxy...)</span></div>
          <div class="ml-4"><span class="text-gray-500">UNPARSEABLE:</span> <span class="text-gray-500">2</span></div>
        </div>

        <!-- Team conversion prompt -->
        <div class="mt-6 bg-blue-900/30 border border-blue-700/50 rounded-lg p-4">
          <div class="flex items-start gap-2">
            <span class="text-blue-400">&#128161;</span>
            <div>
              <p class="text-blue-200">We detected 5 org-specific packages not in the public registry.</p>
              <p class="text-gray-400 mt-2">Want your whole team to get 95% automation instead of 40%?</p>
              <div class="mt-3 space-y-1 text-sm">
                <div><span class="text-blue-300">&rarr;</span> <a href="#" class="text-blue-300 hover:underline">Start a free Team trial (14 days, up to 10 seats)</a></div>
                <div><span class="text-blue-300">&rarr;</span> <span class="text-gray-500">Learn more: devlore.noblefactor.com/teams</span></div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-700">
          <span class="text-gray-500"># Deploy the known packages now</span>
        </div>
        <div class="mt-2">
          <span class="text-gray-400">$</span>
          <span class="text-white"> lore deploy @acme-backend.manifest --known-only</span>
        </div>
        <div class="mt-4 space-y-1">
          <div><span class="text-lore-accent">&#10003;</span> docker installed, verified</div>
          <div><span class="text-lore-accent">&#10003;</span> kubectl --with eks-auth</div>
          <div class="ml-6 text-gray-500 text-xs">aws-iam-authenticator installed, kubeconfig updated, cluster connected</div>
          <div><span class="text-lore-accent">&#10003;</span> go installed, verified</div>
          <div class="text-gray-500">...</div>
        </div>
        <div class="mt-6 pt-4 border-t border-gray-700">
          <span class="text-gray-500"># Tweak config, then capture the working state</span>
        </div>
        <div class="mt-2">
          <span class="text-gray-400">$</span>
          <span class="text-white"> writ adopt acme-backend</span>
        </div>
        <div class="mt-4 space-y-1">
          <div><span class="text-lore-accent">&#10003;</span> packages.manifest captured</div>
          <div><span class="text-lore-accent">&#10003;</span> ~/.kube/config adopted</div>
          <div><span class="text-lore-accent">&#10003;</span> ~/.aws/config adopted</div>
          <div class="text-gray-500 text-xs ml-6">Symlinks created. Ready to commit.</div>
        </div>
        <div class="mt-4 text-gray-400 italic">
          By lunch, pushing your first PR. Next hire runs <code class="text-lore-accent">writ add acme-backend</code> and skips the pain.
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">Why DevLore</h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Built for teams who are tired of "works on my machine."
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-8 h-8 text-lore-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">Cross-Platform</h3>
          <p class="text-gray-400 text-sm">Same manifest works on macOS, Linux, and Windows</p>
        </div>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-8 h-8 text-lore-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">AI Reads Your Wiki</h3>
          <p class="text-gray-400 text-sm">Parses messy docs and produces structured manifests</p>
        </div>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-8 h-8 text-lore-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">Proven Working</h3>
          <p class="text-gray-400 text-sm">Verify phase confirms tools actually function</p>
        </div>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-8 h-8 text-lore-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">Tribal Knowledge</h3>
          <p class="text-gray-400 text-sm">Community captures what took hours to figure out</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest by Design Section -->
  <section class="bg-gray-900/50 py-20">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">Honest by Design</h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Wikis rot. We know. DevLore doesn't pretend to be magic.
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-8 h-8 text-lore-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">Confidence Levels</h3>
          <p class="text-gray-400 text-sm">HIGH, MEDIUM, LOW. We tell you what we know and what we're guessing.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-8 h-8 text-lore-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">Assumptions Reported</h3>
          <p class="text-gray-400 text-sm">"go 1.21+" → go@1.21. We show our work. You can override.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-8 h-8 text-lore-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">Errors Surfaced</h3>
          <p class="text-gray-400 text-sm">"Ask Sarah" isn't automatable. We tell you what we couldn't parse.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-8 h-8 text-lore-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">Iterate Together</h3>
          <p class="text-gray-400 text-sm">AI assistant fills gaps. Each fix improves it for the next person.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Props -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-12 max-w-4xl mx-auto text-center">
        <div>
          <p class="text-5xl font-bold text-lore-accent mb-2">&lt;1 day</p>
          <p class="text-gray-400">to productive, not 3-5 days</p>
        </div>
        <div>
          <p class="text-5xl font-bold text-lore-accent mb-2">3</p>
          <p class="text-gray-400">platforms, one manifest</p>
        </div>
        <div>
          <p class="text-5xl font-bold text-lore-accent mb-2">100%</p>
          <p class="text-gray-400">verified working</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stakeholder Documentation -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-4">For Stakeholders</h2>
        <p class="text-gray-400 text-center mb-8">
          Detailed product requirements, technical specifications, and business strategy.
        </p>
        <DocsLinks scope="devlore" />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-gradient-to-br from-lore-primary to-blue-900">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to automate tribal knowledge?</h2>
      <p class="text-xl text-blue-100 mb-10 max-w-xl mx-auto">
        Join early adopters who have felt the pain of onboarding and decided to fix it.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://github.com/NobleFactor/devlore-cli"
           class="inline-block bg-white text-lore-primary font-semibold px-8 py-3 rounded-lg hover:bg-gray-100 transition">
          Get Started on GitHub
        </a>
        <a href="https://github.com/NobleFactor/noblefactor/tree/main/devlore"
           class="inline-block border-2 border-white text-white font-semibold px-8 py-3 rounded-lg hover:bg-white/10 transition">
          Spec Reviewers
        </a>
        <a href="#demo"
           class="inline-block border-2 border-white text-white font-semibold px-8 py-3 rounded-lg hover:bg-white/10 transition">
          See Demo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
