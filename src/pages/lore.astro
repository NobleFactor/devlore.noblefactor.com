---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoreIcon from '../components/LoreIcon.astro';
import DocsLinks from '../components/DocsLinks.astro';
import CopyableCode from '../components/CopyableCode.astro';
---

<BaseLayout title="Lore - Tribal Knowledge Package Deployer | DevLore" description="Install software with confidence. Four phases: prepare, install, provision, verify.">

  <!-- Hero Section -->
  <section class="container mx-auto px-6 py-20">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row items-center gap-8 mb-12">
        <LoreIcon size={160} class="flex-shrink-0" />
        <div>
          <p class="text-lore-accent font-mono text-sm mb-2 tracking-wider">THE DEPLOYER</p>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Lore</h1>
          <p class="text-xl text-gray-400">
            The tribal knowledge package deployer. Lore doesn't just install software—it
            configures it, verifies it works, and gives you confidence that your environment
            is ready for real work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Four Phases -->
  <section class="bg-gray-900/50 py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8">The Four-Phase Pipeline</h2>
        <p class="text-gray-400 mb-8 text-lg">
          Every package deployment follows the same disciplined process.
        </p>

        <div class="space-y-6">
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0 border-2 border-gray-600">
              <span class="text-gray-400 font-bold">1</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-2">Prepare</h3>
              <p class="text-gray-400">
                Check prerequisites, resolve conflicts, validate the system state.
                "Is Docker already installed? Is there enough disk space? Do we need
                to remove an incompatible version first?"
              </p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0 border-2 border-gray-600">
              <span class="text-gray-400 font-bold">2</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-2">Install</h3>
              <p class="text-gray-400">
                Acquire and install the software using the appropriate method for this
                platform. Homebrew on macOS, apt on Debian, dnf on Fedora, or direct
                binary download when needed.
              </p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0 border-2 border-lore-accent">
              <span class="text-lore-accent font-bold">3</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-2 text-lore-accent">Provision</h3>
              <p class="text-gray-400">
                <strong>This is where lore shines.</strong> The post-install configuration
                that package managers ignore: shell completions, user group membership,
                environment variables, service setup, credential scaffolds.
              </p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0 border-2 border-lore-accent">
              <span class="text-lore-accent font-bold">4</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-2 text-lore-accent">Verify</h3>
              <p class="text-gray-400">
                Confirm the tool actually works. Not just "is the binary present?" but
                "can it do its job?" <code class="text-lore-accent">docker run hello-world</code>
                proves Docker is functional.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero Feature: Onboard -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-4">Hero Feature: Wiki Onboarding</h2>
        <p class="text-gray-400 mb-8 text-lg">
          Point lore at your team's messy onboarding wiki. Get a structured manifest back.
          Discover where org-specific knowledge is hiding.
        </p>

        <div class="bg-gray-800 rounded-lg p-6 font-mono text-sm border border-gray-700 mb-8">
          <div class="mb-2">
            <span class="text-gray-500">$</span>
            <span class="text-white"> lore onboard --from https://wiki.acme.com/backend-setup</span>
          </div>
          <div class="mt-4 space-y-1 text-gray-400">
            <div>Parsing wiki content...</div>
            <div>Matching against registry...</div>
          </div>
          <div class="mt-4 space-y-2">
            <div class="text-gray-400">Found 15 items:</div>
            <div class="ml-2"><span class="text-lore-accent">HIGH:</span> <span class="text-gray-400">docker, kubectl, go, node, helm, bazel</span></div>
            <div class="ml-2"><span class="text-yellow-400">MEDIUM:</span> <span class="text-gray-400">aws-cli, terraform</span></div>
            <div class="ml-2"><span class="text-red-400">LOW:</span> <span class="text-gray-400">acme-cli, acme-secrets, internal-proxy...</span></div>
          </div>

          <!-- Team conversion prompt -->
          <div class="mt-4 bg-blue-900/30 border border-blue-700/50 rounded p-3 text-xs">
            <span class="text-blue-400">&#128161;</span>
            <span class="text-blue-200"> 5 org-specific packages detected.</span>
            <span class="text-gray-400">Team trial: 14 days free.</span>
          </div>

          <div class="mt-4 pt-4 border-t border-gray-700">
            <span class="text-gray-500">Generated:</span> <span class="text-lore-accent">acme-backend.manifest</span>
          </div>
        </div>

        <p class="text-gray-400">
          The <code class="text-lore-accent">--known-only</code> flag deploys only HIGH confidence
          packages. LOW confidence items are flagged for manual review—lore never silently
          installs something unexpected. Team tier unlocks private registries for org-specific packages.
        </p>
      </div>
    </div>
  </section>

  <!-- Complete the Loop -->
  <section class="bg-gray-900/50 py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-4">Complete the Loop</h2>
        <p class="text-gray-400 mb-8 text-lg">
          Lore deploys the baseline. You tweak config to get things working.
          Then <a href="/writ" class="text-lore-accent hover:underline">Writ</a> captures those tweaks for the next person.
        </p>

        <div class="bg-gray-800 rounded-lg p-6 font-mono text-sm border border-gray-700">
          <div class="space-y-4">
            <div>
              <span class="text-gray-500"># Deploy from manifest</span><br>
              <span class="text-gray-400">$</span>
              <span class="text-white"> lore deploy @acme-backend.manifest --known-only</span>
            </div>
            <div class="space-y-1">
              <div><span class="text-lore-accent">&#10003;</span> docker verified</div>
              <div><span class="text-lore-accent">&#10003;</span> kubectl --with eks-auth verified</div>
              <div><span class="text-lore-accent">&#10003;</span> helm, go, node, bazel verified</div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-700">
              <span class="text-gray-500"># Tweak config, then capture with writ</span><br>
              <span class="text-gray-400">$</span>
              <span class="text-white"> writ adopt acme-backend</span>
            </div>
            <div class="text-gray-400 text-xs mt-2">
              Reads lore receipt → captures packages-manifest.yaml + config files
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLI Commands -->
  <section class="bg-gray-900/50 py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8">Key Commands</h2>

        <div class="space-y-6">
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <code class="text-lore-accent font-mono">lore deploy &lt;package&gt;... | @&lt;manifest&gt;</code>
            <p class="text-gray-400 mt-2">
              Deploy packages or manifest files. Each package goes through all four phases.
            </p>
            <div class="mt-3 font-mono text-sm text-gray-500">
              lore deploy docker kubectl --with completions<br>
              lore deploy @team.manifest --known-only
            </div>
          </div>

          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <code class="text-lore-accent font-mono">lore onboard --from &lt;url|file&gt;</code>
            <p class="text-gray-400 mt-2">
              Parse a wiki or setup script and generate a manifest.
            </p>
          </div>

          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <code class="text-lore-accent font-mono">lore reconcile @&lt;receipt&gt;</code>
            <p class="text-gray-400 mt-2">
              Compare deployment receipts against actual system state. Detect drift.
            </p>
          </div>

          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <code class="text-lore-accent font-mono">lore manifest create &lt;name&gt; --ai</code>
            <p class="text-gray-400 mt-2">
              Scaffold a new PMM with AI assistance. Import from existing scripts or URLs.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Safety Features -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8">Built for Trust</h2>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h3 class="text-xl font-semibold mb-3">Dry Run</h3>
            <p class="text-gray-400">
              <code class="text-lore-accent">--dry-run</code> shows what would happen without
              making changes. Review before committing.
            </p>
          </div>
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h3 class="text-xl font-semibold mb-3">Audit Log</h3>
            <p class="text-gray-400">
              Every action is logged. <code class="text-lore-accent">lore audit</code> shows
              what was installed, when, and how.
            </p>
          </div>
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h3 class="text-xl font-semibold mb-3">Signature Verification</h3>
            <p class="text-gray-400">
              PMMs are signed. Lore verifies signatures before executing any code.
            </p>
          </div>
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h3 class="text-xl font-semibold mb-3">Receipts</h3>
            <p class="text-gray-400">
              Deployments produce receipts that track exactly what was installed.
              Use them for upgrades, decommissioning, or audits.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stakeholder Documentation -->
  <section class="bg-gray-900/50 py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <DocsLinks scope="lore" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gradient-to-br from-lore-primary to-blue-900">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-6">Try Lore</h2>
      <p class="text-xl text-blue-100 mb-8 max-w-xl mx-auto">
        Install it and deploy your first package in under a minute.
      </p>
      <div class="mb-8">
        <CopyableCode code="curl -sSL https://devlore.noblefactor.com/install.sh | GITHUB_TOKEN=$(gh auth token) bash" />
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://github.com/NobleFactor/lore"
           class="inline-block bg-white text-lore-primary font-semibold px-8 py-3 rounded-lg hover:bg-gray-100 transition">
          View on GitHub
        </a>
        <a href="/writ"
           class="inline-block border-2 border-white text-white font-semibold px-8 py-3 rounded-lg hover:bg-white/10 transition">
          Learn about Writ &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
