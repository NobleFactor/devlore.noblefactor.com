---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { tools } from "@/lib/tools";

const allDocs = await getCollection("cli");

// One card per product (#457): its root page's description, or the fallback when the collection has no
// root page for it, and its direct subcommands -- the pages one level below the root.
const cards = tools.map((tool) => ({
  name: tool.name,
  description: allDocs.find((d) => d.slug === tool.name)?.data.description || tool.fallback,
  commands: allDocs
    .filter((d) => d.data.tool === tool.name && d.slug !== tool.name && d.slug.split("/").length === 2)
    .sort((a, b) => a.data.command.localeCompare(b.data.command)),
}));

const version = allDocs.find((d) => d.slug === tools[0].name)?.data.version;
---

<BaseLayout title="CLI Reference | DevLore">
  <div class="container mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold mb-2">CLI Reference</h1>
    <p class="text-gray-400 mb-10">
      Complete command reference for the DevLore CLI tools.
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {cards.map((card) => (
        <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
          <h2 class="text-xl font-bold mb-1">
            <a href={`/cli/${card.name}/`} class="hover:text-lore-accent transition">{card.name}</a>
          </h2>
          <p class="text-gray-400 text-sm mb-4">{card.description}</p>
          {card.commands.length > 0 && (
            <ul class="space-y-1">
              {card.commands.map((cmd) => (
                <li class="flex items-baseline gap-2">
                  <a
                    href={`/cli/${cmd.slug}/`}
                    class="text-sm font-mono text-lore-accent hover:underline"
                  >
                    {cmd.data.command}
                  </a>
                  <span class="text-xs text-gray-500">{cmd.data.description}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <p class="text-xs text-gray-600 mt-8">
      Generated from devlore-cli{version ? ` ${version}` : ""}.
    </p>
  </div>
</BaseLayout>
