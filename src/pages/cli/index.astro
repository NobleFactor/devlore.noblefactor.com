---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allDocs = await getCollection("cli");

// Get root commands (top-level: writ.md, lore.md)
const writRoot = allDocs.find((d) => d.slug === "writ");
const loreRoot = allDocs.find((d) => d.slug === "lore");

// Get direct subcommands for each tool
const writCommands = allDocs
  .filter((d) => d.data.tool === "writ" && d.slug !== "writ" && d.slug.split("/").length === 2)
  .sort((a, b) => a.data.command.localeCompare(b.data.command));
const loreCommands = allDocs
  .filter((d) => d.data.tool === "lore" && d.slug !== "lore" && d.slug.split("/").length === 2)
  .sort((a, b) => a.data.command.localeCompare(b.data.command));
---

<BaseLayout title="CLI Reference | DevLore">
  <div class="container mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold mb-2">CLI Reference</h1>
    <p class="text-gray-400 mb-10">
      Complete command reference for the DevLore CLI tools.
    </p>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Writ -->
      <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
        <h2 class="text-xl font-bold mb-1">
          <a href="/cli/writ/" class="hover:text-lore-accent transition">writ</a>
        </h2>
        <p class="text-gray-400 text-sm mb-4">
          {writRoot?.data.description || "Environment manager with platform-aware symlinks"}
        </p>
        {writCommands.length > 0 && (
          <ul class="space-y-1">
            {writCommands.map((cmd) => (
              <li class="flex items-baseline gap-2">
                <a
                  href={`/cli/${cmd.slug}/`}
                  class="text-sm font-mono text-lore-accent hover:underline"
                >
                  {cmd.data.command}
                </a>
                <span class="text-xs text-gray-500">{cmd.data.description}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Lore -->
      <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
        <h2 class="text-xl font-bold mb-1">
          <a href="/cli/lore/" class="hover:text-lore-accent transition">lore</a>
        </h2>
        <p class="text-gray-400 text-sm mb-4">
          {loreRoot?.data.description || "The tribal knowledge package deployer"}
        </p>
        {loreCommands.length > 0 && (
          <ul class="space-y-1">
            {loreCommands.map((cmd) => (
              <li class="flex items-baseline gap-2">
                <a
                  href={`/cli/${cmd.slug}/`}
                  class="text-sm font-mono text-lore-accent hover:underline"
                >
                  {cmd.data.command}
                </a>
                <span class="text-xs text-gray-500">{cmd.data.description}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <p class="text-xs text-gray-600 mt-8">
      Generated from devlore-cli{writRoot?.data.version ? ` ${writRoot.data.version}` : ""}.
    </p>
  </div>
</BaseLayout>
